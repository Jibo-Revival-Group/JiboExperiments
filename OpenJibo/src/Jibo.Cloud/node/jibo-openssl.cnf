[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = api.jibo.com

[v3_req]
subjectAltName = @alt_names
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = api.jibo.com
DNS.2 = api-socket.jibo.com
DNS.3 = neo-hub.jibo.com
DNS.4 = localhost
IP.1 = 127.0.0.1
IP.2 = 192.168.1.110
