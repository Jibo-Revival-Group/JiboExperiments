# Format: backend!credential!model
# - Wolfram: credential is the App ID (model omitted)
# - ChatGPT: credential is the API key (model optional, defaults to gpt-5.4-nano)
# - Ollama: credential is the base URL (optional, defaults to http://127.0.0.1:11434)
#           model optional, defaults to llama3.1:8b
# Use "none" or leave unset to disable knowledge search.
OPENJIBO_SEARCH_BACKEND=none

# WebSocket transport security is enabled by default, including managed mode.
# Set to false only when the managed endpoint must accept ws:// connections.
# OpenJibo__Security__Mode=false

# Optional fallback backend in the same format, tried when primary fails.
OPENJIBO_SEARCH_FALLBACK=

# Optional LLM personality/instructions for Ollama and ChatGPT backends.
# When unset, the built-in Jibo prompt in JiboKnowledgeSearchPrompts.cs is used.
# Use \n for line breaks in .env, or point InstructionsFile at a text file instead.
# OPENJIBO_SEARCH_INSTRUCTIONS=You are a helpful robot.\nKeep answers short.
# OPENJIBO_SEARCH_INSTRUCTIONS_FILE=search-instructions.txt

# Environment variables for encryption.
# After setting these values, DO NOT CHANGE THEM!!! THESE ARE USED TO ENCRYPT AND DECRYPT THE USER'S DATA.
# IF YOU CHANGE THEM, THE USER'S DATA WILL BE UNRECOVERABLE.
# !!!!!!!!!REPLACE WITH YOUR OWN VALUES!!!!!!!!!
OPENJIBO_USER_ENCRYPT="A_Very_Long_And_Strong_Secret_Passphrase_123!"
OPENJIBO_USER_SALT="g7f8e9d0c1b2a3f4e5d6c7b8a9012345"
# !!!!!!!!!REPLACE WITH YOUR OWN VALUES!!!!!!!!!