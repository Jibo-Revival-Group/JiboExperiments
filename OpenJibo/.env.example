# Primary search backend: none | Wolfram | Ollama | ChatGPT
OPENJIBO_SEARCH_BACKEND=none

# API key / App ID (required when Backend=Wolfram or ChatGPT)
OPENJIBO_SEARCH_API_KEY=

# Optional fallback if primary fails
OPENJIBO_SEARCH_FALLBACK_BACKEND=

# Optional endpoint override (defaults vary by backend)
# Wolfram: http://api.wolframalpha.com/v1/spoken
# Ollama: http://127.0.0.1:11434
# ChatGPT: https://api.openai.com/v1/chat/completions
OPENJIBO_SEARCH_API_ENDPOINT=

# Optional endpoint override for the fallback backend
OPENJIBO_SEARCH_FALLBACK_API_ENDPOINT=

# Model for Ollama or ChatGPT (defaults: llama3.1:8b / gpt-5.4-nano)
OPENJIBO_SEARCH_MODEL=

# Model fallback when the primary model is unavailable, or for the fallback backend
OPENJIBO_SEARCH_FALLBACK_MODEL=
